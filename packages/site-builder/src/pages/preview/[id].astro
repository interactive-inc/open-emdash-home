---
import PageShell from '../../PageShell.astro';
import { pageResponse } from '@open-emdash/site-builder/server';
const result = await pageResponse(Astro.params.id ?? '');
// A preview URL must actually authorize this entry; a guessed ID cannot act as a draft URL.
const page = result.page?.isPreview ? result.page : null;
const status = page ? 200 : result.status === 503 ? 503 : 404;
Astro.response.status = status;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<PageShell page={page} status={status} previewRoute />
