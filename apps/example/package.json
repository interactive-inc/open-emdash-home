{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro build",
    "build:cloudflare": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false astro build --config astro.config.cloudflare.mjs",
    "deploy:production": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --config dist-cloudflare/server/wrangler.json",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview --host 127.0.0.1 --port 4332",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "verify": "vp run check && vp run test && vp run build",
    "seed": "emdash seed seed/seed.json --database .data/emdash.db",
    "smoke": "node --use-system-ca scripts/smoke.mjs",
    "setup:local": "node scripts/prepare-local.mjs",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "1.3.1",
    "@open-emdash/site-builder": "workspace:*",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "wrangler": "4.152.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "name": "@open-emdash/example"
}
