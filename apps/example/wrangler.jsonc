{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-example",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EMDASH_SITE_URL": "https://cms.example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emdash-example",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emdash-example-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
